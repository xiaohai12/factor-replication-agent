  "signal": {
    "definition": {
      "value": "Annual firm asset growth rate (ASSETG), calculated as the year-on-year percentage change in total assets.",
      "evidence": [
        {
          "location": "Section I. Data, p. 1613",
          "quote": "Our main variable of concern, the annual firm asset growth rate (ASSETG), is calculated using the year-on-year percentage change in total assets (Compustat data item 6).",
          "table_ref": null,
          "interpretation": ""
        }
      ],
      "status": "clear",
      "unsupported_value": null
    },
    "economic_intuition": {
      "value": "Asset growth captures comprehensive firm investment and disinvestment; higher growth predicts lower subsequent returns, consistent with investor overextrapolation of past gains to growth.",
      "evidence": [
        {
          "location": "Conclusion, p. 1648",
          "quote": "Overall, our findings are most consistent with the interpretation that investors overextrapolate past gains to growth.",
          "table_ref": null,
          "interpretation": ""
        }
      ],
      "status": "clear",
      "unsupported_value": null
    },
    "direction": {
      "value": "negative",
      "evidence": [
        {
          "location": "Abstract, p. 1610",
          "quote": "we document a strong negative correlation between a firm\u2019s asset growth and subsequent abnormal returns.",
          "table_ref": null,
          "interpretation": ""
        }
      ],
      "status": "clear",
      "unsupported_value": null
    },
    "category": "continuous",
    "formula": {
      "paper_expression": "ASSETG(t) = [Data6(t\u22121) \u2212 Data6(t\u22122)] / Data6(t\u22122).",
      "steps": [
        {
          "step_id": "lagged_assets",
          "description": "Retrieve total assets for fiscal years ending in calendar years t\u22121 and t\u22122.",
          "expression": "total_assets_t_minus_1, total_assets_t_minus_2 = total_assets",
          "status": "clear",
          "evidence": [
            {
              "location": "Section I. Data, equation (1), p. 1613",
              "quote": "The firm asset growth rate for year t is estimated as the percentage change in data item 6 from fiscal year ending in calendar year t\u22122 to fiscal year ending in calendar year t\u22121",
              "table_ref": null,
              "interpretation": ""
            }
          ]
        },
        {
          "step_id": "asset_growth",
          "description": "Compute the percentage change in total assets from t\u22122 to t\u22121.",
          "expression": "(total_assets_t_minus_1 - total_assets_t_minus_2) / total_assets_t_minus_2",
          "status": "clear",
          "evidence": [
            {
              "location": "Section I. Data, equation (1), p. 1613",
              "quote": "ASSETG(t) = Data6(t \u22121) \u2212Data6(t \u22122)\nData6(t \u22122)",
              "table_ref": null,
              "interpretation": ""
            }
          ]
        }
      ],
