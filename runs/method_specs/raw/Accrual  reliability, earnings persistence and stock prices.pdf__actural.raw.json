{
  "target_name": "actural",
  "paper": {
    "document_id": "Accrual  reliability, earnings persistence and stock prices.pdf",
    "title": "Accrual Reliability, Earnings Persistence and Stock Prices",
    "citation": "Richardson, S. A., Sloan, R. G., Soliman, M. T., and Tuna, I. (2004). Accrual Reliability, Earnings Persistence and Stock Prices.",
    "publication_year": 2004
  },
  "signal": {
    "definition": {
      "value": "Total accruals from the balance sheet approach, calculated as the sum of changes in working capital, non-current operating assets, and net financial assets, deflated by average total assets.",
      "evidence": [
        {
          "location": "Section 3, Data",
          "quote": "our measure of total accruals, TACC, is defined as follows: TACC = \u2206WC+ \u2206NCO + \u2206FIN",
          "table_ref": null,
          "interpretation": ""
        }
      ],
      "status": "clear",
      "unsupported_value": null
    },
    "economic_intuition": {
      "value": "Higher accruals are less reliable components of earnings, are associated with lower earnings persistence, and are negatively related to future stock returns when investors do not fully anticipate that lower persistence.",
      "evidence": [
        {
          "location": "Section 4.4, Stock Return Results",
          "quote": "the na\u00efve investor hypothesis predicts a negative relation between accruals and future stock returns",
          "table_ref": null,
          "interpretation": ""
        }
      ],
      "status": "clear",
      "unsupported_value": null
    },
    "direction": {
      "value": "negative",
      "evidence": [
        {
          "location": "Table 10, Panel A",
          "quote": "Hedge represents the net return generated by taking a long position in the \u2018Low\u2019 portfolio and an equal sized short position in the \u2018High\u2019 portfolio.",
          "table_ref": null,
          "interpretation": ""
        }
      ],
      "status": "clear",
      "unsupported_value": null
    },
    "category": "continuous",
    "formula": {
      "paper_expression": "TACC = \u2206WC + \u2206NCO + \u2206FIN, where each component is deflated by average total assets.",
      "steps": [
        {
          "step_id": "working_capital",
          "description": "Compute working capital as current operating assets minus current operating liabilities.",
          "expression": "working_capital = (current_assets - cash_and_short_term_investments) - (current_liabilities - debt_in_current_liabilities)",
          "status": "clear",
          "evidence": [
            {
              "location": "Section 3, Data",
              "quote": "WC is calculated as Current Operating Assets (COA) - Current Operating Liabilities (COL), and COA = Current Assets (Compustat Item #4) - Cash and Short Term Investments (STI) (Compustat Item #1), and COL=Current Liabilities (Compustat Item #5) - Debt in Current Liabilities (Compustat Item #34).",
              "table_ref": null,
              "interpretation": ""
            }
          ]
        },
        {
          "step_id": "delta_working_capital",
          "description": "Compute the annual change in working capital.",
          "expression": "delta_working_capital = working_capital_t - working_capital_t_minus_1",
          "status": "clear",
          "evidence": [
            {
              "location": "Section 3, Data",
              "quote": "\u2206WC, the change in net working capital is defined as WCt - WCt-1.",
              "table_ref": null,
              "interpretation": ""
            }
          ]
        },
        {
          "step_id": "noncurrent_operating_assets",
          "description": "Compute net non-current operating assets.",
          "expression": "noncurrent_operating_assets = (total_assets - current_assets - investments_and_advances) - (total_liabilities - current_liabilities - long_term_debt)",
          "status": "clear",
          "evidence": [
            {
              "location": "Section 3, Data",
              "quote": "NCO is calculated as Non-Current Operating Assets (NCOA) - Non-Current Operating Liabilities (NCOL), and NCOA = Total Assets (Compustat item #6) - Current Assets (Compustat Item #4) - Investments and Advances (Compustat Item #32), and NCOL = Total Liabilities (Compustat Item #181) - Current Liabilities (Compustat Item #5) \u2013 Long-Term Debt (Compustat Item #9).",
              "table_ref": null,
              "interpretation": ""
            }
          ]
        },
        {
          "step_id": "delta_noncurrent_operating_assets",
          "description": "Compute the annual change in net non-current operating assets.",
          "expression": "delta_noncurrent_operating_assets = noncurrent_operating_assets_t - noncurrent_operating_assets_t_minus_1",
          "status": "clear",
          "evidence": [
            {
              "location": "Section 3, Data",
              "quote": "\u2206NCO, the change in net non-current operating assets is defined as NCOt - NCOt-1.",
              "table_ref": null,
              "interpretation": ""
            }
          ]
        },
        {
          "step_id": "net_financial_assets",
          "description": "Compute net financial assets.",
          "expression": "net_financial_assets = (short_term_investments + investments_and_advances) - (long_term_debt + debt_in_current_liabilities + preferred_stock)",
          "status": "clear",
          "evidence": [
            {
              "location": "Section 3, Data",
              "quote": "FIN = Financial Assets (FINA) - Financial Liabilities (FINL). FINA = Short Term Investments (STI) (Compustat Item #193) + Long Term Investments (LTI) (Compustat Item #32), and FINL= Long Term Debt (Compustat Item #9) + Debt in Current Liabilities (Compustat Item #34) + Preferred Stock (Compustat Item #130).",
              "table_ref": null,
              "interpretation": ""
            }
          ]
        },
        {
          "step_id": "delta_financial_assets",
          "description": "Compute the annual change in net financial assets.",
          "expression": "delta_financial_assets = net_financial_assets_t - net_financial_assets_t_minus_1",
          "status": "clear",
          "evidence": [
            {
              "location": "Section 3, Data",
              "quote": "\u2206FIN, the change in net financial assets is defined as FINt - FINt-1",
              "table_ref": null,
              "interpretation": ""
            }
          ]
        },
        {
          "step_id": "total_accruals",
          "description": "Sum the three accrual components and deflate by average total assets.",
          "expression": "total_accruals = (delta_working_capital + delta_noncurrent_operating_assets + delta_financial_assets) / average_total_assets",
          "status": "clear",
          "evidence": [
            {
              "location": "Section 3, Data",
              "quote": "As in previous research, we deflate each of these components of earnings by average total assets.",
              "table_ref": null,
              "interpretation": ""
            }
          ]
        }
      ],
      "inputs": [
        "current_assets",
        "cash_and_short_term_investments",
