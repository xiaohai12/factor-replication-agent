  "signal": {
    "definition": {
      "value": "Turnover rate: the number of shares traded divided by the number of shares outstanding, expressed as a percentage.",
      "evidence": [
        {
          "location": "Introduction",
          "quote": "We define the turnover rate of a stock as the number of shares traded divided by the number of shares outstanding in that stock",
          "table_ref": null,
          "interpretation": ""
        }
      ],
      "status": "clear",
      "unsupported_value": null
    },
    "economic_intuition": {
      "value": "Turnover is a proxy for liquidity; lower turnover indicates lower liquidity and is predicted to be associated with higher returns.",
      "evidence": [
        {
          "location": "Section 2",
          "quote": "the observed asset return must be a decreasing function of the turnover rate of that asset",
          "table_ref": null,
          "interpretation": ""
        }
      ],
      "status": "clear",
      "unsupported_value": null
    },
    "direction": {
      "value": "negative",
      "evidence": [
