          "location": "Section 5",
          "quote": "We find that the turnover rate is significantly negatively related to stock returns.",
          "table_ref": null,
          "interpretation": ""
        }
      ],
      "status": "clear",
      "unsupported_value": null
    },
    "category": "continuous",
    "formula": {
      "paper_expression": "For every month t, calculate average monthly trading volume during months t-3, t-2, and t-1 and divide it by the firm's shares outstanding; express the ratio as a percentage.",
      "steps": [
        {
          "step_id": "average_prior_volume",
          "description": "Calculate average monthly trading volume over the three preceding months.",
          "expression": "(trading_volume_t_minus_3 + trading_volume_t_minus_2 + trading_volume_t_minus_1) / 3",
          "status": "clear",
          "evidence": [
            {
              "location": "Section 4",
              "quote": "we calculate the average monthly trading volume (the average number of shares traded during the previous three months, i.e., during months t!3, t!2 and t!1)",
              "table_ref": null,
              "interpretation": ""
            }
          ]
        },
        {
          "step_id": "turnover_rate",
          "description": "Divide average prior-three-month trading volume by shares outstanding and express as a percentage.",
          "expression": "100 * average_prior_volume / shares_outstanding",
          "status": "clear",
          "evidence": [
            {
              "location": "Section 4",
              "quote": "and divide it by the number of shares outstanding of that firm. We then express this ratio as a percentage to obtain our turnover rate variable.",
              "table_ref": null,
              "interpretation": ""
            }
          ]
        }
      ],
