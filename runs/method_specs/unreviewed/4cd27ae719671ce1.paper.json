  "target_name": "oscore",
  "paper": {
    "document_id": "Is the risk of bankruptcy a systematic risk.pdf",
    "title": "Is the Risk of Bankruptcy a Systematic Risk?",
    "citation": "Dichev, Ilia D. (1998), \"Is the Risk of Bankruptcy a Systematic Risk?\", The Journal of Finance 53(3), 1131-1147.",
    "publication_year": 1998
  },
  "signal": {
    "definition": {
      "value": "Ohlson's (1980) Model 1 composite bankruptcy-risk score, denoted O; higher values signify higher probability of bankruptcy.",
      "evidence": [
        {
          "location": "Table I, p. 1136",
          "quote": "O is a measure of bankruptcy risk from Model 1 in Ohlson (1980). Higher values of 0 signify higher probability of bankruptcy.",
          "table_ref": null,
          "interpretation": ""
        }
      ],
      "status": "clear",
      "unsupported_value": null
    },
    "economic_intuition": {
      "value": "The score measures ex ante probability of bankruptcy and is used as a proxy for firm distress.",
      "evidence": [
        {
          "location": "Section I, p. 1134",
          "quote": "The result is a single composite bankruptcy score that reflects the ex ante probability of bankruptcy for each firm at a given point in time.",
          "table_ref": null,
          "interpretation": ""
        }
      ],
      "status": "clear",
      "unsupported_value": null
    },
    "direction": {
      "value": "negative",
      "evidence": [
        {
          "location": "Section II.A, p. 1142",
          "quote": "the regression results confirm the strong negative association between 0 and returns",
          "table_ref": null,
          "interpretation": ""
        }
      ],
      "status": "clear",
      "unsupported_value": null
    },
    "category": "continuous",
    "formula": {
      "paper_expression": "O = -1.32 - 0.407 log(total assets) + 6.03(total liabilities/total assets) - 1.43(working capital/total assets) + 0.076(current liabilities/current assets) - 1.72(1 if total liabilities > total assets, else 0) - 2.37(net income/total assets) - 1.83(funds from operations/total liabilities) + 0.285(1 if net loss for last two years, else 0) - 0.521(net income_t - net income_t_minus_1)/(|net income_t| + |net income_t_minus_1|). The GNP price-level-index adjustment in Ohlson's original specification is omitted.",
      "steps": [
        {
          "step_id": "logged_assets",
          "description": "Take the natural logarithm of total assets; the paper omits Ohlson's GNP price-level-index adjustment.",
          "expression": "log(total_assets)",
          "status": "clear",
          "evidence": [
            {
              "location": "Footnote 4, p. 1133",
              "quote": "I use this model without adjusting for the GNP price-level index because the tests in this study employ monthly cross sections, within which the index is the same.",
              "table_ref": null,
              "interpretation": ""
            }
          ]
        },
        {
          "step_id": "liabilities_to_assets",
          "description": "Compute total liabilities divided by total assets.",
          "expression": "total_liabilities / total_assets",
          "status": "clear",
          "evidence": [
            {
              "location": "Footnote 4, p. 1133",
              "quote": "6.03 (total liabilities/total assets)",
              "table_ref": null,
              "interpretation": ""
            }
          ]
        },
        {
          "step_id": "working_capital_to_assets",
          "description": "Compute working capital divided by total assets.",
          "expression": "working_capital / total_assets",
          "status": "clear",
          "evidence": [
            {
              "location": "Footnote 4, p. 1133",
              "quote": "- 1.43 (working capital/total assets)",
              "table_ref": null,
              "interpretation": ""
            }
          ]
        },
        {
          "step_id": "current_liabilities_to_current_assets",
          "description": "Compute current liabilities divided by current assets.",
          "expression": "current_liabilities / current_assets",
          "status": "clear",
          "evidence": [
            {
              "location": "Footnote 4, p. 1133",
              "quote": "+ 0.076 (current liabilities/current assets)",
              "table_ref": null,
              "interpretation": ""
            }
          ]
        },
        {
          "step_id": "negative_net_worth_indicator",
          "description": "Set an indicator to one when total liabilities exceed total assets, otherwise zero.",
          "expression": "1 if total_liabilities > total_assets else 0",
          "status": "clear",
          "evidence": [
            {
              "location": "Footnote 4, p. 1133",
              "quote": "- 1.72(1 if total liabilities > total assets, else 0)",
              "table_ref": null,
              "interpretation": ""
            }
          ]
        },
        {
          "step_id": "net_income_to_assets",
          "description": "Compute net income divided by total assets.",
          "expression": "net_income / total_assets",
          "status": "clear",
          "evidence": [
            {
              "location": "Footnote 4, p. 1133",
              "quote": "- 2.37(net income/total assets)",
              "table_ref": null,
              "interpretation": ""
            }
          ]
        },
        {
          "step_id": "funds_from_operations_to_liabilities",
          "description": "Compute funds from operations divided by total liabilities.",
          "expression": "funds_from_operations / total_liabilities",
          "status": "clear",
          "evidence": [
            {
              "location": "Footnote 4, p. 1133",
              "quote": "- 1.83(funds from operations/total liabilities)",
              "table_ref": null,
              "interpretation": ""
            }
          ]
        },
        {
          "step_id": "two_year_loss_indicator",
          "description": "Set an indicator to one when net income is negative in each of the last two years, otherwise zero.",
          "expression": "1 if net_income < 0 and prior_net_income < 0 else 0",
          "status": "clear",
          "evidence": [
            {
              "location": "Footnote 4, p. 1133",
              "quote": "+ 0.285(1 if net loss for last two years, else 0)",
              "table_ref": null,
              "interpretation": ""
            }
          ]
        },
        {
          "step_id": "net_income_change",
          "description": "Compute Ohlson's scaled change in net income.",
          "expression": "(net_income - prior_net_income) / (abs(net_income) + abs(prior_net_income))",
          "status": "clear",
          "evidence": [
            {
              "location": "Footnote 4, p. 1133",
              "quote": "- 0.521(net incomet - net incometi,)/(Inet incometi + Inet incomet-1l)",
              "table_ref": null,
              "interpretation": ""
            }
          ]
        },
        {
          "step_id": "oscore",
          "description": "Combine the intercept and weighted component terms to produce the O-score.",
          "expression": "-1.32 - 0.407 * logged_assets + 6.03 * liabilities_to_assets - 1.43 * working_capital_to_assets + 0.076 * current_liabilities_to_current_assets - 1.72 * negative_net_worth_indicator - 2.37 * net_income_to_assets - 1.83 * funds_from_operations_to_liabilities + 0.285 * two_year_loss_indicator - 0.521 * net_income_change",
          "status": "clear",
          "evidence": [
            {
              "location": "Footnote 4, p. 1133",
              "quote": "Ohlson's (1980) model 1 is:",
              "table_ref": null,
              "interpretation": ""
            },
            {
              "location": "Footnote 4, p. 1133",
              "quote": "I use this model without adjusting for the GNP price-level index because the tests in this study employ monthly cross sections, within which the index is the same.",
              "table_ref": null,
              "interpretation": ""
            }
          ]
        }
      ],
      "inputs": [
        "total_assets",
        "total_liabilities",
        "working_capital",
        "current_liabilities",
        "current_assets",
        "net_income",
        "prior_net_income",
        "funds_from_operations"
      ],
      "constants": {},
      "output_concept": "oscore",
      "evidence": [
        {
          "location": "Footnote 4, p. 1133",
          "quote": "Ohlson's (1980) model 1 is: 0 = -1.32 - 0.407 log(total assets/GNP price-level index) + 6.03 (total liabilities/total assets) - 1.43 (working capital/total assets) + 0.076 (current liabilities/current assets) - 1.72(1 if total liabilities > total assets, else 0) - 2.37(net income/total assets) - 1.83(funds from operations/total liabilities) + 0.285(1 if net loss for last two years, else 0) - 0.521(net incomet - net incometi,)/(Inet incometi + Inet incomet-1l).",
          "table_ref": null,
          "interpretation": ""
        },
        {
          "location": "Footnote 4, p. 1133",
          "quote": "I use this model without adjusting for the GNP price-level index because the tests in this study employ monthly cross sections, within which the index is the same.",
          "table_ref": null,
          "interpretation": ""
        }
      ]
