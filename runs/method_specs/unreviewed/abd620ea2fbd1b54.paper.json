{
  "schema_version": "methodspec.v2",
  "factor_id": "abd620ea2fbd1b54",
  "target_name": " zscore",
  "paper": {
    "document_id": "Is the risk of bankruptcy a systematic risk.pdf",
    "title": "Is the Risk of Bankruptcy a Systematic Risk?",
    "citation": "Dichev, Ilia D. 1998. \"Is the Risk of Bankruptcy a Systematic Risk?\" The Journal of Finance 53(3): 1131-1147.",
    "publication_year": 1998
  },
  "signal": {
    "definition": {
      "value": "Altman's (1968) Z-model bankruptcy score, where higher values signify lower probability of bankruptcy.",
      "evidence": [
        {
          "location": "Table I, p. 1136",
          "quote": "Z is the measure of bankruptcy risk from Altman (1968). Higher values of Z signify lower probability of bankruptcy.",
          "table_ref": null,
          "interpretation": ""
        }
      ],
      "status": "clear",
      "unsupported_value": null
    },
    "economic_intuition": {
      "value": "The Z-score is an ex ante measure of bankruptcy risk used to test whether bankruptcy risk is systematic and priced in subsequent stock returns.",
      "evidence": [
        {
          "location": "Section I, p. 1134",
          "quote": "The result is a single composite bankruptcy score that reflects the ex ante probability of bankruptcy for each firm at a given point in time.",
          "table_ref": null,
          "interpretation": ""
        }
      ],
      "status": "clear",
      "unsupported_value": null
    },
    "direction": {
      "value": "positive",
      "evidence": [
        {
          "location": "Section II.A, p. 1139",
          "quote": "the coefficient on Z is positive and highly significant",
          "table_ref": null,
          "interpretation": "Higher Z signifies lower bankruptcy risk; the NYSE-AMEX multivariate association with returns is positive."
        }
      ],
      "status": "clear",
      "unsupported_value": null
    },
    "category": "continuous",
    "formula": {
      "paper_expression": "Z = 1.2(working capital/total assets) + 1.4(retained earnings/total assets) + 3.3(earnings before interest and taxes/total assets) + 0.6(market value of equity/book value of total liabilities) + (sales/total assets).",
      "steps": [
        {
          "step_id": "market_equity",
          "description": "Compute fiscal-year-end market value of equity from CRSP fiscal-year-end price and shares outstanding.",
          "expression": "market_equity = abs(crsp_fiscal_year_end_price) * crsp_fiscal_year_end_shares / 1000",
          "status": "inferred",
          "evidence": [
            {
              "location": "Section I, p. 1134",
              "quote": "Size (MV) is defined as log[fiscal year-end price per share (COMPUSTAT item #199) times number of shares outstanding (item #25)].",
              "table_ref": null,
              "interpretation": "The paper specifies fiscal-year-end price and shares. The CRSP mapping and absolute-price calculation are the approved implementation directive."
            }
          ]
        },
        {
          "step_id": "working_capital_ratio",
          "description": "Compute working capital divided by total assets.",
          "expression": "working_capital_ratio = working_capital / total_assets",
          "status": "clear",
          "evidence": [
            {
              "location": "Footnote 3, p. 1133",
              "quote": "Z = 1.2(working capital/total assets)",
              "table_ref": null,
              "interpretation": ""
            }
          ]
        },
        {
          "step_id": "retained_earnings_ratio",
          "description": "Compute retained earnings divided by total assets.",
          "expression": "retained_earnings_ratio = retained_earnings / total_assets",
          "status": "clear",
          "evidence": [
            {
              "location": "Footnote 3, p. 1133",
              "quote": "+ 1.4(retained earnings/total assets)",
              "table_ref": null,
              "interpretation": ""
            }
          ]
        },
        {
          "step_id": "ebit_ratio",
          "description": "Compute earnings before interest and taxes divided by total assets.",
          "expression": "ebit_ratio = earnings_before_interest_and_taxes / total_assets",
          "status": "clear",
          "evidence": [
            {
              "location": "Footnote 3, p. 1133",
              "quote": "+ 3.3(earnings before interest and taxes/total assets)",
              "table_ref": null,
              "interpretation": ""
            }
          ]
        },
        {
          "step_id": "market_equity_to_liabilities",
          "description": "Compute market value of equity divided by book value of total liabilities.",
          "expression": "market_equity_to_liabilities = market_equity / total_liabilities",
          "status": "clear",
          "evidence": [
            {
              "location": "Footnote 3, p. 1133",
              "quote": "+ 0.6(market value of equity/book value of total liabilities)",
              "table_ref": null,
              "interpretation": ""
            }
          ]
        },
        {
          "step_id": "sales_to_assets",
          "description": "Compute sales divided by total assets.",
          "expression": "sales_to_assets = sales / total_assets",
          "status": "clear",
          "evidence": [
            {
              "location": "Footnote 3, p. 1133",
              "quote": "+ (sales/total assets).",
              "table_ref": null,
              "interpretation": ""
            }
          ]
        },
        {
          "step_id": "z_score",
          "description": "Sum the five weighted Altman Z-model components.",
          "expression": "z_score = 1.2 * working_capital_ratio + 1.4 * retained_earnings_ratio + 3.3 * ebit_ratio + 0.6 * market_equity_to_liabilities + sales_to_assets",
          "status": "clear",
          "evidence": [
            {
              "location": "Footnote 3, p. 1133",
              "quote": "Altman's (1968) model is: Z = 1.2(working capital/total assets) + 1.4(retained earnings/ total assets) + 3.3(earnings before interest and taxes/total assets) + 0.6(market value of equity/ book value of total liabilities) + (sales/total assets).",
              "table_ref": null,
              "interpretation": ""
            }
          ]
        }
      ],
      "inputs": [
        "working_capital",
        "retained_earnings",
        "earnings_before_interest_and_taxes",
        "total_assets",
        "crsp_fiscal_year_end_price",
        "crsp_fiscal_year_end_shares",
        "total_liabilities",
        "sales"
      ],
      "constants": {
        "working_capital_weight": 1.2,
        "retained_earnings_weight": 1.4,
        "ebit_weight": 3.3,
        "market_equity_to_liabilities_weight": 0.6
      },
      "output_concept": "z_score",
      "evidence": [
        {
          "location": "Footnote 3, p. 1133",
          "quote": "Altman's (1968) model is: Z = 1.2(working capital/total assets) + 1.4(retained earnings/ total assets) + 3.3(earnings before interest and taxes/total assets) + 0.6(market value of equity/ book value of total liabilities) + (sales/total assets).",
          "table_ref": null,
          "interpretation": ""
        }
      ]
    },
    "estimation": null
  },
